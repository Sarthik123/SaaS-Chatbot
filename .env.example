# Copy this file to .env and fill in your own values:   cp .env.example .env
# .env is listed in .gitignore, so it is never uploaded to GitHub.
# NEVER paste a real key into a chat, a prompt, a GitHub issue or a commit.
# On Vercel and Render you type these same names and values into their
# "Environment variables" screen instead of using a file.
#
# Empty value = "not set": the app uses a safe default and still starts.

# Postgres connection string (Neon in production, docker-compose locally).
# Local example (the password is a throwaway for the local container only):
#   postgresql+psycopg://support:support@localhost:5432/support_agent
DATABASE_URL=

# Cloudflare Workers AI (the default AI provider).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Which provider to use: cloudflare | openai | fake  ("fake" = free, offline, for tests)
LLM_PROVIDER=cloudflare
# Model names and the embedding size must match each other. See docs/DECISIONS.md.
LLM_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIM=

# Only if you choose OpenAI instead of Cloudflare.
OPENAI_API_KEY=

# Admin area. There is NO default password: if ADMIN_PASSWORD is empty, /admin is disabled.
# Use a long random password, and a different long random SESSION_SECRET.
ADMIN_PASSWORD=
SESSION_SECRET=

# Website addresses allowed to call the API, separated by commas, with https and
# no trailing slash. Empty = http://localhost:3000
ALLOWED_ORIGINS=
